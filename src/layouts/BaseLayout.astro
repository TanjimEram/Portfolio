---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { siteConfig } from '../site.config';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { accentSet } from '../lib/color';

interface Props {
  title?: string;
  description?: string;
  /** Per-page accent override (project "chameleon"). Hex colour. */
  accent?: string;
  /** Absolute or root-relative path to a 1200×630 image */
  ogImage?: string;
  /** Keep out of search results (404, drafts) */
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.seo.description,
  accent,
  ogImage = siteConfig.seo.ogImage,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.seo.title}` : siteConfig.seo.title;
// Astro.site comes from astro.config.ts (site.config url, else the Vercel production URL)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Chameleon: expose the page accent (contrast-corrected per theme) plus a subtle bg tint.
// The <html> style is swapped by ClientRouter on navigation, so leaving the page restores red.
let rootStyle: string | undefined;
if (accent) {
  const a = accentSet(accent);
  rootStyle =
    `--accent-dark: ${a.dark}; --accent-dark-contrast: ${a.darkContrast}; ` +
    `--accent-light: ${a.light}; --accent-light-contrast: ${a.lightContrast}; --bg-tint: 5%;`;
}
---

<!doctype html>
<html lang={siteConfig.seo.lang} style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.seo.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta property="og:locale" content={siteConfig.seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />

    {/* Apply saved theme before first paint; re-apply after view-transition swaps. */}
    <script is:inline>
      (function () {
        function apply() {
          try {
            var t = localStorage.getItem('theme');
            if (t !== 'light' && t !== 'dark') {
              t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            }
            document.documentElement.dataset.theme = t;
          } catch {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-contrast"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
