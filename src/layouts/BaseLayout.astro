---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { siteConfig } from '../site.config';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackgroundFX from '../components/BackgroundFX.astro';
import DevAccentSwitcher from '../components/DevAccentSwitcher.astro';
import { accentSet } from '../lib/color';
import { patternVars, type PatternName } from '../lib/patterns';

interface Props {
  title?: string;
  description?: string;
  /** Per-page accent override (project "chameleon"). Hex colour. */
  accent?: string;
  /** Absolute or root-relative path to a 1200×630 image */
  ogImage?: string;
  /** Keep out of search results (404, drafts) */
  noindex?: boolean;
  /** Background pattern for this page; defaults to site.config `pattern` */
  pattern?: PatternName;
}

const {
  title,
  description = siteConfig.seo.description,
  accent,
  ogImage = siteConfig.seo.ogImage,
  noindex = false,
  pattern = siteConfig.pattern,
} = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.seo.title}` : siteConfig.seo.title;
// Astro.site comes from astro.config.ts (site.config url, else the Vercel production URL)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Chameleon: expose the page accent (raw for fills, contrast-corrected "ink" for text) plus a subtle bg tint.
// The <html> style is swapped by ClientRouter on navigation, so leaving the page restores red.
// The pattern travels the same way (BackgroundFX cross-fades when these change).
let rootStyle = patternVars(pattern);
if (accent) {
  const a = accentSet(accent);
  rootStyle +=
    ` --accent-dark: ${a.dark}; --accent-dark-ink: ${a.darkInk}; --accent-dark-contrast: ${a.darkContrast};` +
    ` --accent-light: ${a.light}; --accent-light-ink: ${a.lightInk}; --accent-light-contrast: ${a.lightContrast};` +
    ` --bg-tint: 4%;`;
}
---

<!doctype html>
<html lang={siteConfig.seo.lang} style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.seo.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta property="og:locale" content={siteConfig.seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0c" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafb" />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    {/* Apply saved theme before first paint; re-apply after view-transition swaps. `js` class gates the reveal styles. */}
    <script is:inline>
      (function () {
        function apply() {
          try {
            // ?theme=light|dark forces a theme for this load (screenshots, testing) without persisting it
            var q = new URLSearchParams(location.search).get('theme');
            var t = q === 'light' || q === 'dark' ? q : localStorage.getItem('theme');
            if (t !== 'light' && t !== 'dark') {
              t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            }
            document.documentElement.dataset.theme = t;
          } catch {}
          // Experience mode: saved choice, but never auto-enable "full" for reduced-motion users
          try {
            var x = localStorage.getItem('experience');
            var rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
            document.documentElement.dataset.experience = x === 'full' && !rm ? 'full' : 'standard';
          } catch {
            document.documentElement.dataset.experience = 'standard';
          }
          document.documentElement.classList.add('js');
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-contrast"
    >
      Skip to content
    </a>
    <BackgroundFX />
    <div class="scroll-progress" aria-hidden="true"></div>
    <Nav />
    <main id="main" class="relative z-10 flex-1">
      <slot />
    </main>
    <Footer />
    <div class="cursor-dot" aria-hidden="true" transition:persist="cursor-dot"></div>
    {import.meta.env.DEV && <DevAccentSwitcher />}
  </body>
</html>

<script>
  import '../lib/experience';
  import '../scripts/motion';
</script>
