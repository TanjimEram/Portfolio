---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const { org, role, type, start, end, highlights, links } = entry.data;
---

<li class="card p-6 sm:p-7" data-reveal>
  <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-muted">
    <span>
      <time datetime={start}>{start}</time> – {end ? <time datetime={end}>{end}</time> : 'present'}
    </span>
    <span class="uppercase tracking-[0.15em]">{type}</span>
  </div>
  <h3 class="mt-4 text-xl font-bold tracking-tight">{role}</h3>
  <p class="mt-1 text-muted">{org}</p>
  {
    highlights.length > 0 && (
      <ul class="mt-5 space-y-2 text-sm leading-relaxed text-muted">
        {highlights.map((h) => (
          <li class="flex gap-3">
            <span class="mt-[0.7em] h-px w-3 shrink-0 bg-accent transition-colors duration-500" aria-hidden="true" />
            <span>{h}</span>
          </li>
        ))}
      </ul>
    )
  }
  {
    links && links.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-4 text-sm font-medium">
        {links.map((l) => (
          <li>
            <a href={l.href} class="inline-block py-1 text-accent-ink hover:underline" target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
