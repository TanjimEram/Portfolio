---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const { org, role, type, start, end, highlights, links } = entry.data;
---

<li class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
  <div class="font-mono text-xs text-muted sm:pt-1">
    <time datetime={start}>{start}</time> – {end ? <time datetime={end}>{end}</time> : 'present'}
    <span class="block capitalize">{type}</span>
  </div>
  <div>
    <h3 class="font-medium">
      {role} <span class="text-muted">· {org}</span>
    </h3>
    {
      highlights.length > 0 && (
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-muted marker:text-border">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    {
      links && links.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-4 text-sm">
          {links.map((l) => (
            <li>
              <a href={l.href} class="text-accent hover:underline" target="_blank" rel="noopener">
                {l.label} ↗
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
