---
/** Small status pill: Shipped / In development / Ongoing (project frontmatter `status`). */
import { statusLabels, type ProjectStatus } from '../lib/projects';

interface Props {
  status: ProjectStatus;
  class?: string;
}
const { status, class: className } = Astro.props;
---

<span class:list={['status-badge', `is-${status}`, className]}>
  <i aria-hidden="true"></i>
  {statusLabels[status]}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted);
  }
  .status-badge i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    border: 1.5px solid var(--color-accent);
    transition: border-color 600ms ease, background-color 600ms ease;
  }
  /* shipped: solid dot · in development: half · ongoing: hollow */
  .is-shipped i {
    background: var(--color-accent);
  }
  .is-in-development i {
    background: linear-gradient(90deg, var(--color-accent) 50%, transparent 50%);
  }
</style>
