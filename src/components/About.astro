---
import { siteConfig } from '../site.config';
import Section from './Section.astro';

const { about, education, location } = siteConfig;
---

<Section id="about" title="About">
  <div class="max-w-prose space-y-4 leading-relaxed">
    {about.map((sentence) => <p>{sentence}</p>)}
  </div>

  <dl class="mt-8 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-[auto_1fr]">
    {
      education.length > 0 && (
        <>
          <dt class="font-mono text-xs uppercase tracking-wide text-muted sm:pt-0.5">Education</dt>
          <dd>
            <ul class="space-y-2">
              {education.map((e) => (
                <li>
                  <span>{e.degree}</span>
                  <span class="text-muted"> · {e.institution}</span>
                  <span class="block text-muted sm:inline sm:before:content-['_·_']">
                    {e.start}–{e.end ?? 'present'}
                  </span>
                </li>
              ))}
            </ul>
          </dd>
        </>
      )
    }
    <dt class="font-mono text-xs uppercase tracking-wide text-muted sm:pt-0.5">Based in</dt>
    <dd>{location}</dd>
  </dl>
</Section>
