---
/**
 * Speaker toggle = mute for the sound layer. Sound itself is a Full Experience module
 * (src/lib/experience.ts): it plays only in full mode, and only when not muted.
 * The toggle is hidden in standard mode. The sound module (src/scripts/sound.ts) is imported on demand.
 */
---

<button
  type="button"
  data-sound-toggle
  class="sound-toggle inline-flex size-11 items-center justify-center rounded-full sm:size-9 text-muted transition-colors hover:bg-surface-2 hover:text-text"
  aria-pressed="true"
  aria-label="Sound on"
  title="Mute sound"
>
  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M11 5 6 9H3v6h3l5 4V5Z" />
    {/* muted cross (off) */}
    <path class="off" d="m22 9-6 6M16 9l6 6" />
    {/* equaliser bars (on) */}
    <g class="eq" stroke-width="2">
      <path d="M15 10v4" style="--d: 0s" />
      <path d="M18 8v8" style="--d: 0.15s" />
      <path d="M21 11v2" style="--d: 0.3s" />
    </g>
  </svg>
</button>

<style>
  .sound-toggle .eq {
    display: none;
  }
  .sound-toggle[aria-pressed='true'] .off {
    display: none;
  }
  .sound-toggle[aria-pressed='true'] .eq {
    display: initial;
  }
  .sound-toggle[aria-pressed='true'] .eq path {
    transform-box: fill-box;
    transform-origin: center;
    animation: eq 900ms ease-in-out infinite alternate;
    animation-delay: var(--d);
  }
  @keyframes eq {
    from {
      transform: scaleY(0.4);
    }
    to {
      transform: scaleY(1.4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sound-toggle[aria-pressed='true'] .eq path {
      animation: none;
    }
  }
</style>

<script>
  import { registerModule, isFull } from '../lib/experience';

  const KEY = 'sound';
  const read = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };

  let muted = read() === 'off';
  let mod: typeof import('../scripts/sound') | undefined;

  const paint = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(!muted));
      b.setAttribute('aria-label', muted ? 'Sound off' : 'Sound on');
      b.title = muted ? 'Unmute sound' : 'Mute sound';
    });
  };

  const play = async () => {
    mod ??= await import('../scripts/sound');
    mod.setEnabled(true);
  };

  registerModule({
    id: 'sound',
    enable: () => (muted ? undefined : play()),
    disable: () => mod?.setEnabled(false),
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-sound-toggle]')) return;
    muted = !muted;
    try {
      localStorage.setItem(KEY, muted ? 'off' : 'on');
    } catch {}
    paint();
    if (muted) mod?.setEnabled(false);
    else if (isFull()) void play();
  });

  document.addEventListener('astro:page-load', paint);
  paint();
</script>
