---
/**
 * Speaker toggle for the optional sound layer (site.config `features.synthHover`).
 * Off by default; the choice persists in localStorage. With prefers-reduced-motion the saved
 * "on" is not auto-applied on load — the visitor has to switch it on each visit.
 * The sound module itself (src/scripts/sound.ts) is only imported once sound is turned on.
 */
---

<button
  type="button"
  data-sound-toggle
  class="sound-toggle inline-flex size-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-text"
  aria-pressed="false"
  aria-label="Sound off"
  title="Toggle sound"
>
  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M11 5 6 9H3v6h3l5 4V5Z" />
    {/* muted cross (off) */}
    <path class="off" d="m22 9-6 6M16 9l6 6" />
    {/* equaliser bars (on) */}
    <g class="eq" stroke-width="2">
      <path d="M15 10v4" style="--d: 0s" />
      <path d="M18 8v8" style="--d: 0.15s" />
      <path d="M21 11v2" style="--d: 0.3s" />
    </g>
  </svg>
</button>

<style>
  .sound-toggle .eq {
    display: none;
  }
  .sound-toggle[aria-pressed='true'] .off {
    display: none;
  }
  .sound-toggle[aria-pressed='true'] .eq {
    display: initial;
  }
  .sound-toggle[aria-pressed='true'] .eq path {
    transform-box: fill-box;
    transform-origin: center;
    animation: eq 900ms ease-in-out infinite alternate;
    animation-delay: var(--d);
  }
  @keyframes eq {
    from {
      transform: scaleY(0.4);
    }
    to {
      transform: scaleY(1.4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sound-toggle[aria-pressed='true'] .eq path {
      animation: none;
    }
  }
</style>

<script>
  const KEY = 'sound';
  const TOAST_KEY = 'sound-toast';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stored = () => {
    try {
      return localStorage.getItem(KEY) === 'on';
    } catch {
      return false;
    }
  };

  let on = false;
  let mod: typeof import('../scripts/sound') | undefined;

  const paint = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', on ? 'Sound on' : 'Sound off');
    });
  };

  const toast = (text: string) => {
    const el = document.createElement('div');
    el.setAttribute('role', 'status');
    el.className =
      'fixed bottom-6 left-1/2 z-50 -translate-x-1/2 rounded-full border border-border bg-surface px-4 py-2 text-sm shadow-lg';
    el.textContent = text;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 3200);
  };

  const apply = async (next: boolean, fromGesture: boolean) => {
    on = next;
    paint();
    try {
      localStorage.setItem(KEY, on ? 'on' : 'off');
    } catch {}
    if (!on) {
      mod?.setEnabled(false);
      return;
    }
    mod ??= await import('../scripts/sound');
    mod.setEnabled(true);
    if (fromGesture) {
      try {
        if (!localStorage.getItem(TOAST_KEY)) {
          localStorage.setItem(TOAST_KEY, '1');
          toast('Sound on — hover the projects.');
        }
      } catch {}
    }
  };

  // Restore a saved "on" — but never auto-enable for reduced-motion users.
  if (stored() && !reduced) void apply(true, false);

  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-sound-toggle]')) void apply(!on, true);
  });
  document.addEventListener('astro:page-load', paint);
</script>
