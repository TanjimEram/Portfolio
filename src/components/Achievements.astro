---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const entries = (await getCollection('achievements')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title),
);
---

<Section id="achievements" title="Achievements">
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      entries.map(({ data }) => (
        <li class="rounded border border-border p-4">
          <div class="flex items-baseline justify-between gap-3 font-mono text-xs text-muted">
            <span class="capitalize">{data.category}</span>
            {data.year && <span>{data.year}</span>}
          </div>
          <h3 class="mt-2 font-medium">{data.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">{data.detail}</p>
        </li>
      ))
    }
  </ul>
</Section>
