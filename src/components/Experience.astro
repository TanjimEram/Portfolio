---
import { getCollection } from 'astro:content';
import ExperienceItem from './ExperienceItem.astro';
import Section from './Section.astro';

import type { PatternName } from '../lib/patterns';

interface Props {
  number?: number;
  pattern?: PatternName;
}
const { number, pattern } = Astro.props;

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<Section id="experience" title="Experience & Leadership" label="Experience" number={number} pattern={pattern} wide>
  <ol class="grid gap-5 lg:grid-cols-2" data-reveal-group>
    {entries.map((entry) => <ExperienceItem entry={entry} />)}
  </ol>
</Section>
