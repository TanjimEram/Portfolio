---
import { siteConfig } from '../site.config';
import Section from './Section.astro';

const { email, links, resume, resumeFilename } = siteConfig;
---

<Section id="contact" title="Contact">
  <p class="max-w-prose text-muted">Email is the quickest way to reach me.</p>
  <a href={`mailto:${email}`} class="mt-3 inline-block text-lg font-medium text-accent hover:underline">{email}</a>
  <ul class="mt-5 flex flex-wrap gap-4 text-sm">
    <li><a href={links.github} class="inline-block py-1 text-muted hover:text-accent" target="_blank" rel="me noopener">GitHub ↗</a></li>
    <li><a href={links.linkedin} class="inline-block py-1 text-muted hover:text-accent" target="_blank" rel="me noopener">LinkedIn ↗</a></li>
    <li><a href={resume} download={resumeFilename} class="inline-block py-1 text-muted hover:text-accent">Download resume (PDF)</a></li>
  </ul>
</Section>
