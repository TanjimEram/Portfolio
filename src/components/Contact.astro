---
import { siteConfig } from '../site.config';
import Section from './Section.astro';

import type { PatternName } from '../lib/patterns';

interface Props {
  number?: number;
  pattern?: PatternName;
}
const { number, pattern } = Astro.props;
const { email, links, resume, resumeFilename } = siteConfig;
---

<Section id="contact" title="Get in touch" label="Contact" number={number} pattern={pattern} wide>
  <div class="card p-7 sm:p-10" data-reveal>
    <p class="max-w-[46ch] text-muted">Email is the quickest way to reach me.</p>
    <a
      href={`mailto:${email}`}
      class="mt-4 inline-block text-2xl font-bold tracking-tight text-accent-ink transition-colors duration-500 hover:underline sm:text-3xl"
    >
      {email}
    </a>
    <ul class="mt-8 flex flex-wrap gap-3 text-sm">
      <li><a href={links.github} class="btn-outline" target="_blank" rel="me noopener">GitHub ↗</a></li>
      <li><a href={links.linkedin} class="btn-outline" target="_blank" rel="me noopener">LinkedIn ↗</a></li>
      <li><a href={resume} download={resumeFilename} class="btn-outline">Download resume (PDF)</a></li>
    </ul>
  </div>
</Section>
