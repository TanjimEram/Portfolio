---
import { siteConfig } from '../site.config';
import Section from './Section.astro';

const { email, links, resume } = siteConfig;
---

<Section id="contact" title="Contact">
  <p class="max-w-prose text-muted">Email is the quickest way to reach me.</p>
  <a href={`mailto:${email}`} class="mt-3 inline-block text-lg font-medium text-accent hover:underline">{email}</a>
  <ul class="mt-6 flex flex-wrap gap-4 text-sm">
    <li><a href={links.github} class="text-muted hover:text-accent" target="_blank" rel="me noopener">GitHub ↗</a></li>
    <li><a href={links.linkedin} class="text-muted hover:text-accent" target="_blank" rel="me noopener">LinkedIn ↗</a></li>
    <li><a href={resume} class="text-muted hover:text-accent" target="_blank" rel="noopener">Resume ↗</a></li>
  </ul>
</Section>
