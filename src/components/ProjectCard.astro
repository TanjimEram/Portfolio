---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** 1-based index shown as a mono counter */
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, tech, live, repo, image, color, pattern, status } = project.data;
const href = `/projects/${project.id}/`;
const num = String(index).padStart(2, '0');
---

<article class="card group flex flex-col" data-reveal data-sound-note={index - 1}>
  {
    image ? (
      <Image
        src={image}
        alt=""
        widths={[480, 800, 1000]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="aspect-[16/10] w-full object-cover"
        transition:name={`project-image-${project.id}`}
      />
    ) : (
      <ProjectCover title={title} color={color} pattern={pattern} transitionName={`project-image-${project.id}`} />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-3 font-mono text-xs text-muted">
      <span class="flex items-center gap-3">
        {num}
        {status && <StatusBadge status={status} />}
      </span>
      {tech[0] && <span class="truncate uppercase tracking-[0.15em]">{tech[0]}</span>}
    </div>
    <h3 class="mt-4 text-xl font-bold tracking-tight">
      {/* Stretched link: the whole card is clickable; other links sit above it via z-10 */}
      <a href={href} class="after:absolute after:inset-0 group-hover:text-accent-ink" transition:name={`project-title-${project.id}`}>
        {title}
      </a>
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{summary}</p>
    {
      tech.length > 1 && (
        <ul class="mt-5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted" aria-label="Technologies">
          {tech.slice(1).map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
    {
      (live || repo) && (
        <ul class="relative z-10 mt-4 flex gap-4 text-sm font-medium">
          {live && (
            <li>
              <a href={live} class="tap-target inline-block py-1 text-accent-ink hover:underline" target="_blank" rel="noopener">
                Live ↗
              </a>
            </li>
          )}
          {repo && (
            <li>
              <a href={repo} class="tap-target inline-block py-1 text-accent-ink hover:underline" target="_blank" rel="noopener">
                Source ↗
              </a>
            </li>
          )}
        </ul>
      )
    }
  </div>
</article>
