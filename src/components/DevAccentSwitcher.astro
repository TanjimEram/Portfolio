---
/**
 * DEV ONLY (BaseLayout renders it when import.meta.env.DEV). Lets you preview the chameleon
 * by writing the same <html> variables a project page would. "Reset" restores the page's own accent.
 */
import { FINE_SCALE, patternNames, patterns } from '../lib/patterns';

const presets = ['#e8412f', '#2563eb', '#f59e0b', '#22c55e', '#7c3aed', '#0ea5e9', '#ec4899', '#111111', '#ffffff'];
// Pre-render every pattern's variables so the client can swap without shipping the generator
const patternOptions = patternNames.map((name) => {
  const p = patterns[name]();
  const fine = `${Math.max(2, Math.round(p.width * FINE_SCALE))}px ${Math.max(2, Math.round(p.height * FINE_SCALE))}px`;
  return { name, image: p.uri, size: `${p.width}px ${p.height}px`, fine, rotate: `${p.rotation}deg` };
});
---

<div class="dev-accent" data-dev-accent aria-label="Dev accent switcher">
  <span class="label-mono" style="letter-spacing: 0.12em">accent</span>
  {presets.map((c) => <button type="button" data-accent={c} style={`background:${c}`} aria-label={`Accent ${c}`} />)}
  <input type="color" value="#e8412f" aria-label="Custom accent" />
  <select aria-label="Background pattern" data-pattern-select>
    <option value="">pattern…</option>
    {patternOptions.map((p) => <option value={p.name} data-image={p.image} data-size={p.size} data-fine={p.fine} data-rotate={p.rotate}>{p.name}</option>)}
  </select>
  <a href="/dev/patterns" class="reset">patterns</a>
  <a href="/dev/doodles" class="reset">doodles</a>
  <a href="/dev/discovery" class="reset">eggs</a>
  <a href="/dev/terminal" class="reset">term</a>
  <button type="button" data-accent="" class="reset">Reset</button>
</div>

<style>
  .dev-accent {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .dev-accent button[data-accent]:not(.reset) {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .dev-accent input {
    width: 1.4rem;
    height: 1.4rem;
    padding: 0;
    border: 0;
    background: none;
  }
  /* dev tool: never on phones (it is 700px wide and would force a horizontal layout) */
  @media (width < 48rem) {
    .dev-accent {
      display: none;
    }
  }
  .dev-accent .reset {
    color: var(--color-muted);
    padding-inline: 0.3rem;
  }
  .dev-accent select {
    max-width: 6.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    color: var(--color-text);
    padding: 0.15rem 0.4rem;
    font: inherit;
  }
</style>

<script>
  import { accentSet } from '../lib/color';

  const apply = (hex: string) => {
    const root = document.documentElement;
    const vars = ['dark', 'dark-ink', 'dark-contrast', 'light', 'light-ink', 'light-contrast'];
    if (!hex) {
      vars.forEach((v) => root.style.removeProperty(`--accent-${v}`));
      root.style.removeProperty('--bg-tint');
      // ClientRouter will restore the page's own inline style on the next navigation; for now, reload it
      if (root.dataset.pageAccent) root.setAttribute('style', root.dataset.pageAccent);
      return;
    }
    const a = accentSet(hex);
    root.style.setProperty('--accent-dark', a.dark);
    root.style.setProperty('--accent-dark-ink', a.darkInk);
    root.style.setProperty('--accent-dark-contrast', a.darkContrast);
    root.style.setProperty('--accent-light', a.light);
    root.style.setProperty('--accent-light-ink', a.lightInk);
    root.style.setProperty('--accent-light-contrast', a.lightContrast);
    root.style.setProperty('--bg-tint', '4%');
  };

  document.addEventListener('astro:page-load', () => {
    const root = document.documentElement;
    root.dataset.pageAccent = root.getAttribute('style') ?? '';
  });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-dev-accent] [data-accent]');
    if (btn) apply(btn.dataset.accent ?? '');
  });
  document.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.matches('[data-dev-accent] input[type=color]')) apply(input.value);
  });

  // Pattern: write the same <html> variables BaseLayout renders, then let BackgroundFX cross-fade
  document.addEventListener('change', (e) => {
    const select = e.target as HTMLSelectElement;
    if (!select.matches('[data-dev-accent] [data-pattern-select]')) return;
    const opt = select.selectedOptions[0];
    if (!opt?.value) return;
    const root = document.documentElement;
    root.style.setProperty('--pattern-image', opt.dataset.image ?? '');
    root.style.setProperty('--pattern-size', opt.dataset.size ?? '');
    root.style.setProperty('--pattern-size-fine', opt.dataset.fine ?? '');
    root.style.setProperty('--pattern-rotate', opt.dataset.rotate ?? '0deg');
    document.dispatchEvent(new CustomEvent('fx:pattern'));
  });
</script>
