---
/**
 * DEV ONLY (BaseLayout renders it when import.meta.env.DEV). Lets you preview the chameleon
 * by writing the same <html> variables a project page would. "Reset" restores the page's own accent.
 */
const presets = ['#e8412f', '#2563eb', '#f59e0b', '#22c55e', '#7c3aed', '#0ea5e9', '#ec4899', '#111111', '#ffffff'];
---

<div class="dev-accent" data-dev-accent aria-label="Dev accent switcher">
  <span class="label-mono" style="letter-spacing: 0.12em">accent</span>
  {presets.map((c) => <button type="button" data-accent={c} style={`background:${c}`} aria-label={`Accent ${c}`} />)}
  <input type="color" value="#e8412f" aria-label="Custom accent" />
  <button type="button" data-accent="" class="reset">Reset</button>
</div>

<style>
  .dev-accent {
    position: fixed;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .dev-accent button[data-accent]:not(.reset) {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .dev-accent input {
    width: 1.4rem;
    height: 1.4rem;
    padding: 0;
    border: 0;
    background: none;
  }
  .dev-accent .reset {
    color: var(--color-muted);
    padding-inline: 0.3rem;
  }
</style>

<script>
  import { accentSet } from '../lib/color';

  const apply = (hex: string) => {
    const root = document.documentElement;
    const vars = ['dark', 'dark-ink', 'dark-contrast', 'light', 'light-ink', 'light-contrast'];
    if (!hex) {
      vars.forEach((v) => root.style.removeProperty(`--accent-${v}`));
      root.style.removeProperty('--bg-tint');
      // ClientRouter will restore the page's own inline style on the next navigation; for now, reload it
      if (root.dataset.pageAccent) root.setAttribute('style', root.dataset.pageAccent);
      return;
    }
    const a = accentSet(hex);
    root.style.setProperty('--accent-dark', a.dark);
    root.style.setProperty('--accent-dark-ink', a.darkInk);
    root.style.setProperty('--accent-dark-contrast', a.darkContrast);
    root.style.setProperty('--accent-light', a.light);
    root.style.setProperty('--accent-light-ink', a.lightInk);
    root.style.setProperty('--accent-light-contrast', a.lightContrast);
    root.style.setProperty('--bg-tint', '4%');
  };

  document.addEventListener('astro:page-load', () => {
    const root = document.documentElement;
    root.dataset.pageAccent = root.getAttribute('style') ?? '';
  });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-dev-accent] [data-accent]');
    if (btn) apply(btn.dataset.accent ?? '');
  });
  document.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.matches('[data-dev-accent] input[type=color]')) apply(input.value);
  });
</script>
