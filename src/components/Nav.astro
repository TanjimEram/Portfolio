---
import { siteConfig } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import ExperienceToggle from './ExperienceToggle.astro';
import MobileMenu from './MobileMenu.astro';

const initials = siteConfig.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/75 backdrop-blur-md transition-colors duration-500">
  <nav class="container-wide flex h-[var(--header-h)] items-center justify-between gap-2" aria-label="Primary">
    <a href="/" class="inline-flex min-h-11 min-w-11 items-center gap-2 font-mono text-sm font-medium tracking-[0.2em] uppercase hover:text-accent-ink" aria-label={`${initials} — home`}>
      <span class="inline-block size-2 rounded-full bg-accent transition-colors duration-500" aria-hidden="true"></span>
      {initials}
    </a>

    {/* ≥ 640px: everything inline */}
    <div class="hidden items-center gap-2 sm:flex">
      <ul class="flex items-center gap-2">
        {
          siteConfig.nav.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center rounded-full px-3 text-sm text-muted transition-colors hover:bg-surface-2 hover:text-text">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ExperienceToggle />
      <SoundToggle />
      <ThemeToggle />
    </div>

    {/* < 640px: discoveries counter + Full Experience dot + menu button; links and toggles live in the sheet */}
    <div class="flex items-center gap-1 sm:hidden">
      <span class="disc-slot" data-discovery-slot></span>
      <ExperienceToggle />
      <MobileMenu />
    </div>
  </nav>
</header>
