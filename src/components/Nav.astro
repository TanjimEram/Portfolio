---
import { siteConfig } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const initials = siteConfig.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <nav class="container-narrow flex h-14 items-center justify-between" aria-label="Primary">
    <a href="/" class="inline-flex min-h-9 items-center font-mono text-sm font-semibold tracking-wide hover:text-accent" aria-label="Home">
      {initials}
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          siteConfig.nav.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded px-2 py-1 text-sm text-muted transition-colors hover:text-text sm:px-3"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
