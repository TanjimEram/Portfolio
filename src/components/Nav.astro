---
import { siteConfig } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';

const initials = siteConfig.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/75 backdrop-blur-md transition-colors duration-500">
  <nav class="container-wide flex h-[var(--header-h)] items-center justify-between" aria-label="Primary">
    <a href="/" class="inline-flex min-h-9 items-center gap-2 font-mono text-sm font-medium tracking-[0.2em] uppercase hover:text-accent-ink" aria-label={`${initials} — home`}>
      <span class="inline-block size-2 rounded-full bg-accent transition-colors duration-500" aria-hidden="true"></span>
      {initials}
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          siteConfig.nav.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-full px-2.5 py-1.5 text-sm text-muted transition-colors hover:bg-surface-2 hover:text-text sm:px-3"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <SoundToggle />
      <ThemeToggle />
    </div>
  </nav>
</header>
