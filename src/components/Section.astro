---
import { patternVars, type PatternName } from '../lib/patterns';

interface Props {
  id: string;
  title: string;
  /** Optional pattern drawn inside this section (site.config `sectionPatterns`) */
  pattern?: PatternName;
  /** 1-based position among enabled sections; shown as "01" in the label */
  number?: number;
  /** Short mono label; defaults to the title */
  label?: string;
  /** Use the wide container (grids) instead of the narrow reading column */
  wide?: boolean;
}

const { id, title, number, label = title, wide = false, pattern } = Astro.props;
const num = number !== undefined ? String(number).padStart(2, '0') : undefined;
---

<section id={id} class:list={[wide ? 'container-wide' : 'container-narrow', 'relative py-16 sm:py-24']}>
  {pattern && <div class="section-pattern" aria-hidden="true" style={patternVars(pattern)} />}
  <header class="mb-8 sm:mb-10" data-reveal>
    <p class="label-mono flex items-center gap-3">
      {num && <span>{num}</span>}
      {num && <span class="h-px w-6 bg-current opacity-60" aria-hidden="true"></span>}
      <span>{label}</span>
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  </header>
  <slot />
</section>
