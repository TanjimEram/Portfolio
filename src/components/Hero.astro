---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../site.config';

const { name, role, links, email, resume, hero, stats } = siteConfig;

// Portrait lives in src/assets so astro:assets can optimise it; missing file → silhouette placeholder.
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const portrait = hero.portrait ? assets[`../assets/${hero.portrait}`]?.default : undefined;

const iconClass = 'size-5';
---

<section id="hero" class="relative overflow-hidden">
  <div class="container-wide grid items-center gap-10 pt-16 pb-20 sm:pt-24 sm:pb-28 lg:grid-cols-[1.15fr_0.85fr] lg:gap-8">
    <div data-reveal-group>
      <p class="label-mono" data-reveal>{hero.eyebrow}</p>
      <h1 class="display-name mt-5" data-reveal>
        {name}<span class="text-accent" aria-hidden="true">.</span>
      </h1>
      <p class="mt-6 max-w-[46ch] text-lg text-muted sm:text-xl" data-reveal>{role}</p>

      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
        <a href={hero.cta.href} class="group inline-flex items-center gap-3 font-semibold">
          <span class="btn-circle" aria-hidden="true">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
          {hero.cta.label}
        </a>
        <a href={resume} class="btn-outline" target="_blank" rel="noopener" type="application/pdf">Resume</a>

        <ul class="flex items-center gap-1">
          <li>
            <a href={links.github} class="inline-flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:text-accent-ink" aria-label="GitHub" target="_blank" rel="me noopener">
              <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
            </a>
          </li>
          <li>
            <a href={links.linkedin} class="inline-flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:text-accent-ink" aria-label="LinkedIn" target="_blank" rel="me noopener">
              <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`} class="inline-flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:text-accent-ink" aria-label="Email">
              <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Portrait over a big accent disc that bleeds off the right edge */}
    <div class="portrait-wrap relative mx-auto w-full max-w-sm lg:max-w-none" data-reveal>
      <div class="portrait-disc" aria-hidden="true"></div>
      <div class="portrait relative aspect-[4/5] overflow-hidden rounded-[var(--radius-card)]">
        {
          portrait ? (
            <Image
              src={portrait}
              alt={hero.portraitAlt}
              widths={[400, 640, 960]}
              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 384px, 90vw"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <svg class="h-full w-full" viewBox="0 0 400 500" role="img" aria-label="Portrait placeholder">
              <rect width="400" height="500" fill="#2a2a2e" />
              <circle cx="200" cy="190" r="80" fill="#a1a1aa" />
              <path d="M60 500c0-110 62-170 140-170s140 60 140 170Z" fill="#a1a1aa" />
            </svg>
          )
        }
        <div class="duotone" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  {
    stats.length > 0 && (
      <div class="container-wide">
        <dl class="grid grid-cols-1 gap-x-8 gap-y-6 border-t border-border py-8 sm:grid-cols-3" data-reveal-group>
          {stats.map((s) => (
            <div class="flex flex-col-reverse" data-reveal>
              <dt class="mt-1 text-sm text-muted">{s.label}</dt>
              <dd class="text-3xl font-bold tracking-tight sm:text-4xl">
                <span data-count={s.value} data-suffix={s.suffix ?? ''}>
                  {s.value.toLocaleString('en')}{s.suffix ?? ''}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>

<style>
  /* Diameter = portrait height, so it only ever bleeds sideways (off the viewport edge), never above/below */
  .portrait-disc {
    position: absolute;
    top: 0;
    bottom: 0;
    right: -28%;
    aspect-ratio: 1;
    border-radius: 9999px;
    /* colour via background-color so it transitions; the gradient only adds a soft highlight */
    background-color: var(--color-accent);
    background-image: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.16), transparent 60%);
    opacity: 0.92;
    transition: background-color 600ms ease;
  }
  @media (width >= 64rem) {
    .portrait-disc {
      right: -38%;
    }
  }
  /* Duotone: grayscale image + accent multiply → black-to-accent */
  .portrait {
    isolation: isolate;
    background: var(--color-surface);
  }
  .portrait :global(img),
  .portrait svg {
    filter: grayscale(1) contrast(1.05);
  }
  .duotone {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    mix-blend-mode: multiply; /* dark theme: black → accent */
    transition: background-color 600ms ease;
  }
  :global(:root[data-theme='light']) .duotone {
    mix-blend-mode: screen; /* light theme: accent → white, so the portrait reads light like the page */
  }
</style>
