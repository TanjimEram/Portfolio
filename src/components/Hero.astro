---
import { siteConfig } from '../site.config';

const iconClass = 'size-5';
---

<section id="hero" class="container-narrow py-20 sm:py-28">
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{siteConfig.name}</h1>
  <p class="mt-3 max-w-prose text-lg text-muted">{siteConfig.role}</p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href="#projects"
      class="rounded bg-accent px-4 py-2 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
    >
      View projects
    </a>
    <a
      href={siteConfig.resume}
      class="rounded border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
      target="_blank"
      rel="noopener"
    >
      Resume
    </a>

    <ul class="ml-1 flex items-center gap-1">
      <li>
        <a href={siteConfig.links.github} class="inline-flex size-9 items-center justify-center rounded text-muted hover:text-accent" aria-label="GitHub" target="_blank" rel="me noopener">
          <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
        </a>
      </li>
      <li>
        <a href={siteConfig.links.linkedin} class="inline-flex size-9 items-center justify-center rounded text-muted hover:text-accent" aria-label="LinkedIn" target="_blank" rel="me noopener">
          <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${siteConfig.email}`} class="inline-flex size-9 items-center justify-center rounded text-muted hover:text-accent" aria-label="Email">
          <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </a>
      </li>
    </ul>
  </div>
</section>
