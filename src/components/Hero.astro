---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Signature from './Signature.astro';
import { siteConfig } from '../site.config';

const { name, role, links, email, resume, resumeFilename, hero, stats, signature } = siteConfig;

// Cut-out portrait under /public (scripts/process-images.py): PNG with alpha, plus optional WebP siblings.
const pub = (p: string) => resolve(process.cwd(), 'public', p.replace(/^\//, ''));
const pngSize = (p: string) => {
  // IHDR: width/height are the two big-endian uint32s at bytes 16–24 of a PNG
  const b = readFileSync(pub(p));
  return { width: b.readUInt32BE(16), height: b.readUInt32BE(20) };
};
const portrait = hero.portrait && existsSync(pub(hero.portrait)) ? hero.portrait : undefined;
const webp = portrait?.replace(/\.png$/, '.webp');
const webpSm = portrait?.replace(/\.png$/, '-sm.webp');
const sizes = portrait ? pngSize(portrait) : undefined;
const hasWebp = !!webp && existsSync(pub(webp));
const hasWebpSm = !!webpSm && existsSync(pub(webpSm));

const iconClass = 'size-5';
---

<section id="hero" class="relative overflow-hidden">
  <div class="container-wide grid items-center gap-10 pt-16 pb-20 sm:pt-24 sm:pb-28 lg:grid-cols-[1.15fr_0.85fr] lg:gap-8">
    <div data-reveal-group>
      <p class="label-mono" data-reveal>{hero.eyebrow}</p>
      <h1 class="display-name mt-5" data-reveal>
        {name}<span class="text-accent" aria-hidden="true">.</span>
      </h1>
      <p class="mt-6 max-w-[46ch] text-lg text-muted sm:text-xl" data-reveal>{role}</p>
      <p class="mt-4 max-w-[52ch] text-muted" data-reveal>{hero.intro}</p>

      <div class="hero-actions mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
        <a href={hero.cta.href} class="group inline-flex items-center gap-3 font-semibold">
          <span class="btn-circle" aria-hidden="true">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
          {hero.cta.label}
        </a>
        <a href={resume} class="btn-outline" download={resumeFilename} type="application/pdf">{hero.resumeLabel}</a>

        <ul class="flex items-center gap-1">
          <li>
            <a href={links.github} class="inline-flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:text-accent-ink" aria-label="GitHub" target="_blank" rel="me noopener">
              <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
            </a>
          </li>
          <li>
            <a href={links.linkedin} class="inline-flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:text-accent-ink" aria-label="LinkedIn" target="_blank" rel="me noopener">
              <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`} class="inline-flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:text-accent-ink" aria-label="Email">
              <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Cut-out portrait standing on a big accent disc; the signature hangs off its bottom edge */}
    <div class="portrait-wrap relative mx-auto w-full max-w-sm lg:max-w-none" data-reveal>
      <div class="portrait relative aspect-[4/5]">
        <div class="portrait-disc" aria-hidden="true"></div>
        <div class="portrait-clip">
          {
            portrait && sizes ? (
              <picture>
                {hasWebpSm && <source media="(max-width: 639px)" srcset={webpSm} type="image/webp" />}
                {hasWebp && <source srcset={webp} type="image/webp" />}
                <img
                  src={portrait}
                  alt={hero.portraitAlt}
                  width={sizes.width}
                  height={sizes.height}
                  class="portrait-img"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
            ) : (
              <svg class="portrait-img" viewBox="0 0 400 500" role="img" aria-label="Portrait placeholder">
                <circle cx="200" cy="150" r="80" fill="#a1a1aa" />
                <path d="M60 500c0-110 62-170 140-170s140 60 140 170Z" fill="#a1a1aa" />
              </svg>
            )
          }
          {/* tint: a light accent wash multiplied over the grayscale photo, masked to the cut-out so the disc stays clean */}
          <div class="duotone" aria-hidden="true" style={hasWebp ? `--portrait-mask: url(${webp})` : portrait ? `--portrait-mask: url(${portrait})` : undefined}></div>
        </div>
      </div>
      {signature && <Signature class="hero-signature" aria-hidden="true" />}
    </div>
  </div>

  {
    stats.length > 0 && (
      <div class="container-wide">
        <dl class="grid grid-cols-1 gap-x-8 gap-y-6 border-t border-border py-8 min-[26rem]:grid-cols-2 sm:grid-cols-3" data-reveal-group>
          {stats.map((s) => (
            <div class="flex flex-col-reverse" data-reveal>
              <dt class="mt-1 text-sm text-muted">{s.label}</dt>
              <dd class="text-3xl font-bold tracking-tight sm:text-4xl">
                <span data-count={s.value} data-suffix={s.suffix ?? ''}>
                  {s.value.toLocaleString('en')}{s.suffix ?? ''}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>

<style>
  .portrait-wrap {
    /* room for the signature hanging below the disc */
    padding-bottom: 12%;
  }
  /* Disc: diameter = column width, sitting on the bottom edge; the head rises above it */
  .portrait-disc {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    aspect-ratio: 1;
    border-radius: 9999px;
    /* colour via background-color so it transitions; the gradient only adds a soft highlight */
    background-color: var(--color-accent);
    background-image: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.16), transparent 60%);
    opacity: 0.92;
    transition: background-color 600ms ease;
  }
  /* The photo is cut off at the legs; clipping its box to the disc's lower half hides that flat edge */
  .portrait-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 0 0 50% 50% / 0 0 40% 40%; /* aspect 4/5: half the width = 40% of the height */
    isolation: isolate;
  }
  .portrait-clip picture,
  .portrait-clip :global(.portrait-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .portrait-clip :global(img.portrait-img) {
    object-fit: contain;
    object-position: 50% 100%;
    filter: grayscale(1) contrast(1.05);
  }
  .portrait-clip svg.portrait-img {
    filter: grayscale(1);
  }
  .duotone {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    mix-blend-mode: multiply;
    /* a light wash, not a full duotone: the photo stays mostly grayscale with a reddish cast */
    opacity: var(--portrait-tint, 0.35);
    transition: background-color 600ms ease;
    /* the same cut-out as a mask, so only the person is tinted */
    mask-image: var(--portrait-mask);
    mask-size: contain;
    mask-position: 50% 100%;
    mask-repeat: no-repeat;
  }
  .duotone:not([style]) {
    /* placeholder silhouette: no mask available, keep the tint off */
    display: none;
  }
  /* long-hover discovery: the photo becomes line art */
  .portrait.is-sketch :global(.portrait-img) {
    filter: url(#sketch-ink);
  }
  .portrait.is-sketch .duotone {
    opacity: 0.6;
  }
  /* light theme keeps multiply too: `screen` would turn the dark suit accent-coloured and lose it against the disc */

  /* Signature: below the portrait, overlapping the disc's bottom edge, tilted, ~40% of the portrait width */
  .hero-signature {
    position: absolute;
    left: 50%;
    bottom: 3%;
    width: 40%;
    height: auto;
    transform: translateX(-42%) rotate(-5deg);
    color: var(--color-accent);
    transition: color 600ms ease;
    pointer-events: none;
  }
  /* a hairline stroke keeps the thin strokes legible at this size on any screen */
  .hero-signature :global(path) {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  /* Full Experience: it writes itself once on load */
  :global(html.js[data-experience='full']) .hero-signature :global(path) {
    stroke-dasharray: 1;
    animation:
      sig-draw 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s both,
      sig-fill 0.5s ease 1.7s both;
  }
  @keyframes sig-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes sig-fill {
    from {
      fill-opacity: 0;
    }
    to {
      fill-opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-signature :global(path) {
      animation: none !important;
    }
  }
  /* On phones the portrait stacks under the text with the stats row below it, so there is room for the
     signature at every width; hide it only if the portrait itself is ever hidden. */
</style>
