---
/**
 * DEV ONLY routes: /dev/patterns and /dev/doodles. No static paths in production, so nothing is emitted to dist/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternGallery from '../../components/dev/PatternGallery.astro';
import DoodleGallery from '../../components/dev/DoodleGallery.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'patterns' } }, { params: { page: 'doodles' } }] : [];
}

const { page } = Astro.params;
const titles = { patterns: 'Patterns', doodles: 'Doodles' } as const;
---

<BaseLayout title={titles[page as keyof typeof titles]} description="Dev gallery" noindex>
  {page === 'doodles' ? <DoodleGallery /> : <PatternGallery />}
</BaseLayout>
