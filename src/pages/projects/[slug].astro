---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, description, tech, repo, live, image, color } = project.data;

// GitHub drafts copy the summary into description; don't print the same line twice.
const showDescription = description.trim() !== summary.trim();
---

<BaseLayout title={title} description={description} accent={color}>
  <article class="container-narrow py-12 sm:py-20">
    <a href="/#projects" class="label-mono inline-block py-1 transition-colors hover:text-text">← Work</a>

    <header class="mt-8" data-reveal-group>
      <h1 class="text-4xl font-extrabold tracking-[-0.03em] sm:text-6xl" transition:name={`project-title-${project.id}`} data-reveal>
        {title}<span class="text-accent" aria-hidden="true">.</span>
      </h1>
      <p class="mt-5 max-w-[46ch] text-lg text-muted sm:text-xl" data-reveal>{summary}</p>

      {
        tech.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2 font-mono text-xs" aria-label="Technologies" data-reveal>
            {tech.map((t) => (
              <li class="rounded-full border border-border bg-surface-2 px-3 py-1 text-muted">{t}</li>
            ))}
          </ul>
        )
      }

      {
        (live || repo) && (
          <div class="mt-8 flex flex-wrap gap-3" data-reveal>
            {live && (
              <a href={live} class="btn-solid" target="_blank" rel="noopener">
                Live site ↗
              </a>
            )}
            {repo && (
              <a href={repo} class="btn-outline" target="_blank" rel="noopener">
                Source ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      image && (
        <div class="card mt-12" data-reveal>
          <Image
            src={image}
            alt={`Screenshot of ${title}`}
            widths={[640, 1024, 1408]}
            sizes="(min-width: 720px) 704px, 100vw"
            class="w-full"
            loading="eager"
          />
        </div>
      )
    }

    {showDescription && <p class="mt-12 max-w-[46ch] text-lg text-muted" data-reveal>{description}</p>}

    <div class:list={['prose-basic max-w-[60ch]', showDescription ? 'mt-6' : 'mt-12']} data-reveal>
      <Content />
    </div>
  </article>
</BaseLayout>
