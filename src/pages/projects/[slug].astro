---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, description, tech, repo, live, image, color } = project.data;

// GitHub drafts copy the summary into description; don't print the same line twice.
const showDescription = description.trim() !== summary.trim();
---

<BaseLayout title={title} description={description} accent={color}>
  <article class="container-narrow py-12 sm:py-16">
    <a href="/#projects" class="text-sm text-muted transition-colors hover:text-accent">← Projects</a>

    <header class="mt-6">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl" transition:name={`project-title-${project.id}`}>
        {title}
      </h1>
      <p class="mt-3 max-w-prose text-lg text-muted">{summary}</p>

      {
        tech.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs" aria-label="Technologies">
            {tech.map((t) => (
              <li class="rounded border border-border px-2 py-1 text-muted">{t}</li>
            ))}
          </ul>
        )
      }

      {
        (live || repo) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {live && (
              <a
                href={live}
                class="rounded bg-accent px-4 py-2 text-sm font-medium text-accent-contrast transition-[background-color,opacity] hover:opacity-90"
                target="_blank"
                rel="noopener"
              >
                Live site ↗
              </a>
            )}
            {repo && (
              <a
                href={repo}
                class="rounded border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
                target="_blank"
                rel="noopener"
              >
                Source ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      image && (
        <Image
          src={image}
          alt={`Screenshot of ${title}`}
          widths={[640, 1024, 1344]}
          sizes="(min-width: 720px) 672px, 100vw"
          class="mt-10 w-full rounded border border-border"
          loading="eager"
        />
      )
    }

    {showDescription && <p class="mt-10 max-w-prose leading-relaxed">{description}</p>}

    <div class:list={['prose-basic max-w-prose', showDescription ? 'mt-6' : 'mt-10']}>
      <Content />
    </div>
  </article>
</BaseLayout>
