---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist." noindex>
  <section class="container-narrow py-24 sm:py-32">
    <p class="label-mono">404</p>
    <h1 class="mt-4 text-4xl font-extrabold tracking-[-0.03em] sm:text-6xl">Page not found<span class="text-accent" aria-hidden="true">.</span></h1>
    <p class="mt-5 max-w-[46ch] text-muted">The link may be old, or the page may have moved.</p>
    <a href="/" class="btn-solid mt-8">Back to home</a>
  </section>
</BaseLayout>
