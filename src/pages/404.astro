---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist." noindex>
  <section class="container-narrow py-24 sm:py-32">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-prose text-muted">The link may be old, or the page may have moved.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded bg-accent px-4 py-2 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
