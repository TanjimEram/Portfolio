---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { siteConfig, type SectionId } from '../site.config';

const enabled = siteConfig.sections.filter((s) => s.enabled).map((s) => s.id);

// Placeholder counts until each section component is built.
const projects = await getCollection('projects');
const experience = await getCollection('experience');
const achievements = await getCollection('achievements');

const placeholder: Record<Exclude<SectionId, 'hero'>, { title: string; note: string }> = {
  about: { title: 'About', note: siteConfig.about.join(' ') },
  projects: { title: 'Projects', note: `${projects.length} project(s) in the collection.` },
  experience: { title: 'Experience & Leadership', note: `${experience.length} entr(y/ies) in the collection.` },
  skills: { title: 'Skills', note: Object.keys(siteConfig.skills).join(' · ') },
  achievements: { title: 'Achievements', note: `${achievements.length} entr(y/ies) in the collection.` },
  contact: { title: 'Contact', note: siteConfig.email },
};
---

<BaseLayout>
  {
    enabled.map((id) =>
      id === 'hero' ? (
        <Hero />
      ) : (
        <section id={id} class="container-narrow border-t border-border py-14">
          <h2 class="text-xl font-semibold tracking-tight">{placeholder[id].title}</h2>
          <p class="mt-3 text-muted">{placeholder[id].note}</p>
        </section>
      ),
    )
  }
</BaseLayout>
